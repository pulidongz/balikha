#!/usr/bin/env node
//
// bin/dev
//
// Starts the Next dev server on DEV_PORT from .env.development and points
// Caddy at it.
//
// ── Why the port is fixed ─────────────────────────────────────────────────
// DEV_PORT is registered to this project in ~/.claude/dev-ports.toml, so no
// other project on this machine claims it. A bare `next dev` silently moves to
// the next port when its port is taken and reports itself healthy, while Caddy
// keeps proxying to the old port. The HTTPS URL then returns 502 or, worse,
// serves whatever other project sits on that port. This wrapper probes
// DEV_PORT once and refuses to start when anything holds it, naming the
// holder, instead of moving.
//
// ── Why 8443 is guarded too ───────────────────────────────────────────────
// The PUBLIC port (8443) is baked into BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL
// (.env.development) and into the Google OAuth redirect URIs registered in
// Google Cloud Console. Silently relocating it would leave the app running and
// Google sign-in broken. So if a stranger holds 8443 this script stops and
// says so.
//
// ── How Caddy learns the port ─────────────────────────────────────────────
// The Caddyfile reads `{$BALIKHA_DEV_PORT:3600}`, which Caddy substitutes at
// config-load time. docker-compose passes the variable into the container, so
// `docker compose up -d caddy` with a changed value recreates the container
// and reloads the config. No file templating, nothing generated into the repo.

import { spawn, spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { createServer, createConnection } from 'node:net';
import { parseEnv } from 'node:util';

const ENV_FILE = new URL('../.env.development', import.meta.url);
const PUBLIC_PORT = 8443;
const CADDY_CONTAINER = 'balikha_caddy';

/**
 * DEV_PORT from .env.development, parsed with Node's own env-file parser (the
 * same one the `tsx --env-file=.env.development` scripts use). Throws by name
 * when the value is missing or is not a TCP port number.
 */
function readDevPort() {
  const values = parseEnv(readFileSync(ENV_FILE, 'utf8'));
  const raw = values.DEV_PORT;
  if (raw === undefined) {
    throw new Error(
      'DEV_PORT is missing from .env.development.\n' +
        '\n' +
        '  Add DEV_PORT=3600 (the port registered to balikha in\n' +
        '  ~/.claude/dev-ports.toml). See .env.example.',
    );
  }
  const port = Number(raw);
  if (!/^\d+$/.test(raw) || port < 1 || port > 65535) {
    throw new Error(`DEV_PORT in .env.development must be a TCP port number, got "${raw}".`);
  }
  return port;
}

/**
 * True when binding the wildcard address fails because the port is in use.
 * Any other bind error is unexpected and is rethrown.
 */
function wildcardBindIsRefused(port) {
  return new Promise((resolve, reject) => {
    const probe = createServer();
    probe.once('error', (error) => {
      if (error.code === 'EADDRINUSE') {
        resolve(true);
        return;
      }
      reject(error);
    });
    probe.once('listening', () => probe.close(() => resolve(false)));
    probe.listen(port, '0.0.0.0');
  });
}

/**
 * True when anything listens on `port`.
 *
 * The wildcard bind alone is not enough on macOS: a listener on 127.0.0.1 or
 * ::1 does not stop a later 0.0.0.0 bind, and the loopback listener then wins
 * every localhost request. So the probe also tries to connect on both
 * loopback addresses.
 */
async function portIsTaken(port) {
  if (await wildcardBindIsRefused(port)) return true;
  if (await portIsAccepting(port, '127.0.0.1')) return true;
  return portIsAccepting(port, '::1');
}

/**
 * The listening processes on `port`, as "PID <pid> (<command>)" entries, read
 * from `lsof -F`. Throws when lsof itself fails.
 */
function describePortHolders(port) {
  const result = spawnSync('lsof', ['-nP', `-iTCP:${port}`, '-sTCP:LISTEN', '-Fpc'], {
    encoding: 'utf8',
  });
  if (result.error) {
    throw new Error(
      `Could not run lsof to find the holder of port ${port}: ${result.error.message}`,
    );
  }
  // lsof exits 1 with no output when it can list no matching socket. That is
  // the case for a listener owned by another user, which lsof cannot see
  // without sudo.
  if (result.status === 1 && result.stdout === '' && result.stderr === '') {
    return `a process lsof cannot see (try: sudo lsof -nP -iTCP:${port} -sTCP:LISTEN)`;
  }
  if (result.status !== 0) {
    throw new Error(`lsof exited ${result.status} while checking port ${port}: ${result.stderr}`);
  }

  const holders = [];
  for (const line of result.stdout.split('\n')) {
    if (line.startsWith('p')) holders.push({ pid: line.slice(1), command: '' });
    if (line.startsWith('c')) holders[holders.length - 1].command = line.slice(1);
  }
  if (holders.length === 0) {
    throw new Error(
      `lsof reported success for port ${port} but listed no process: ${result.stdout}`,
    );
  }
  return holders.map(({ pid, command }) => `PID ${pid} (${command})`).join(', ');
}

/**
 * Guards the dev port. Returns nothing when it is free; throws naming the
 * holder when it is not.
 */
async function assertDevPortIsFree(port) {
  if (!(await portIsTaken(port))) return;

  throw new Error(
    `Port ${port} (DEV_PORT in .env.development) is in use by ${describePortHolders(port)}.\n` +
      `\n` +
      `  ${port} is registered to balikha in ~/.claude/dev-ports.toml, so bin/dev\n` +
      `  does not move to another port. Stop the holder, or stop this dev session.`,
  );
}

/** True when something accepts a TCP connection on `host`:`port`. */
function portIsAccepting(port, host) {
  return new Promise((resolve) => {
    const socket = createConnection({ port, host });
    const done = (answer) => {
      socket.destroy();
      resolve(answer);
    };
    socket.once('connect', () => done(true));
    socket.once('error', () => done(false));
    socket.setTimeout(1000, () => done(false));
  });
}

/** True when OUR caddy container is the thing running. */
function ourCaddyIsRunning() {
  const result = spawnSync(
    'docker',
    ['ps', '--filter', `name=${CADDY_CONTAINER}`, '--format', '{{.Names}}'],
    { encoding: 'utf8' },
  );
  return result.status === 0 && result.stdout.includes(CADDY_CONTAINER);
}

/**
 * Guards the public port. Returns nothing on success; throws with an
 * actionable message when a process that is NOT our Caddy holds it.
 */
async function assertPublicPortIsOurs() {
  const occupied = await portIsAccepting(PUBLIC_PORT, '127.0.0.1');
  if (!occupied) return;
  if (ourCaddyIsRunning()) return;

  throw new Error(
    `Port ${PUBLIC_PORT} is in use, but it is not the ${CADDY_CONTAINER} container.\n` +
      `\n` +
      `  ${PUBLIC_PORT} is deliberately NOT auto-adjusted: it is baked into\n` +
      `  BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL, and into the Google OAuth\n` +
      `  redirect URIs registered in Google Cloud Console. Moving it would leave\n` +
      `  the app running with Google sign-in quietly broken.\n` +
      `\n` +
      `  Find the holder:  lsof -nP -iTCP:${PUBLIC_PORT} -sTCP:LISTEN\n` +
      `  Then stop it, or stop this dev session.`,
  );
}

function startCaddy(devPort) {
  // `up -d` (not `restart`) because compose recreates the container when an
  // environment value changes — which is exactly how Caddy picks up the new
  // port. A `restart` would reuse the old env and silently keep proxying to
  // the previous port, reintroducing the bug this script exists to prevent.
  const result = spawnSync('docker', ['compose', 'up', '-d', 'caddy'], {
    stdio: 'inherit',
    env: { ...process.env, BALIKHA_DEV_PORT: String(devPort) },
  });

  if (result.status !== 0) {
    throw new Error(
      'docker compose up -d caddy failed. Is Docker running? ' +
        'HTTPS URLs will not work until it is.',
    );
  }
}

// Every failure below is a condition the developer has to act on, and the
// message says what to do. A raw Node stack trace on top of it buries the one
// line that matters, so failures print the message alone and exit 1.
function fail(error) {
  console.error(`\n${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(1);
}

let devPort;
try {
  devPort = readDevPort();
  await assertDevPortIsFree(devPort);
  await assertPublicPortIsOurs();
  startCaddy(devPort);
} catch (error) {
  fail(error);
}

// padEnd rather than hand-counted spaces: devPort is variable-width, so a
// literal run of spaces misaligns the moment the port is not four digits.
const urls = [
  [`https://dev.balikha.art:${PUBLIC_PORT}`, 'use this — Google OAuth works here'],
  [`https://balikha.localhost:${PUBLIC_PORT}`, 'no OAuth; no /etc/hosts needed'],
  [`http://localhost:${devPort}`, 'direct, no TLS — handy for curl'],
];
const width = Math.max(...urls.map(([url]) => url.length));

console.log(
  ['', '  Balikha dev server', '']
    .concat(urls.map(([url, note]) => `    ${url.padEnd(width)}  (${note})`))
    .concat('')
    .join('\n'),
);

// stdio: 'inherit' hands the TTY straight to Next, so its output, its
// interactive prompts and Ctrl-C all behave exactly as `next dev` would.
const next = spawn('npx', ['next', 'dev', '-p', String(devPort)], {
  stdio: 'inherit',
  env: process.env,
});

// Caddy is deliberately left running on exit: it is shared infrastructure
// (`docker compose up -d` starts it alongside Postgres and MinIO), and tearing
// it down here would surprise anyone with a second shell open. `docker compose
// down` remains the way to stop it.
next.on('exit', (code, signal) => {
  process.exit(signal ? 1 : (code ?? 0));
});
